# Development environment variables
# These are used when running locally (ng serve) or in Vercel Preview deployments

OPENWEATHERMAP_API_KEY=your_dev_api_key_here

WEATHER_API_BASE=https://api.open-meteo.com/v1
GEOCODING_API_BASE=https://geocoding-api.open-meteo.com/v1
AIR_QUALITY_API_BASE=https://air-quality-api.open-meteo.com/v1
OPENWEATHERMAP_BASE=https://api.openweathermap.org/data/2.5
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
